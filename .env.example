# ── Core ─────────────────────────────────────────────────────────────────────
APP_NAME=TriageOps
ENVIRONMENT=development
DATABASE_URL=sqlite:///./triageops.db
LOG_LEVEL=INFO

# ── Triage policy ────────────────────────────────────────────────────────────
# Minimum budget (USD) for a lead to be considered qualified.
BUDGET_THRESHOLD=5000
# Minimum brief length used by the completeness scorer (20-2000).
MIN_DESCRIPTION_CHARS=60

# rules | auto | openai | gemini
# "auto" uses OpenAI/Gemini when a key is present, otherwise rules.
TRIAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=12

# ── Demo / development helpers ───────────────────────────────────────────────
# Seed a handful of realistic leads into an empty database on startup.
SEED_DEMO_DATA=true
# Expose POST /api/demo/seed for resetting an empty dashboard.
ENABLE_DEMO_TOOLS=true

# Comma-separated list of allowed browser origins for cross-origin API use.
# Leave empty when the dashboard is served by this same app.
CORS_ORIGINS=
